<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- The OblivionMP SDK packages every project builds against -->
        <OblivionSdkVersion>1.0.0-rc.1</OblivionSdkVersion>
    </PropertyGroup>

</Project>
