<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>OblivionMp.SnapshotLoader.Serverside</RootNamespace>
        <!-- The fetched seed: data the mod folder carries, not the build. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);seed/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ReadyM.SDK.Oblivion.Server" Version="$(OblivionSdkVersion)" />
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
    </ItemGroup>

</Project>
